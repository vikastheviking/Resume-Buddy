# Resume-Buddy environment configuration.
# Copy to .env and fill in what you need: every value below has a working default
# except GROQ_API_KEY/GEMINI_API_KEY (AI rewrites) and the Supabase values (auth/DB).

# ---------------------------------------------------------------------------
# AI engine (Dual-Tier: Gemini Primary -> Groq Fallback)
# ---------------------------------------------------------------------------
# Primary: Google Gemini API (Get key from https://aistudio.google.com)
# The application tries Gemini first.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Fallback: Groq Cloud (Free key from https://console.groq.com)
# If Gemini hits its rate limit or quota, Groq seamlessly takes over.
GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=groq/compound
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Output budget per LLM call. The optimizer's response is a full structured resume
# (contact, summary, skills, every bullet, education) plus audit metadata — raise this
# if you see truncated/unparseable JSON in the logs for long resumes.
# LLM_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Supabase (database + authentication)
# ---------------------------------------------------------------------------
# All accounts, sessions, and OTP email delivery are handled by Supabase Auth - this
# app never sends email itself. Project Settings -> API in your Supabase dashboard.
#
# Run supabase_profiles_setup.sql once in the Supabase SQL Editor first (creates the
# profiles table + trigger that stores full name/phone alongside each auth.users row).
#
# In the Supabase dashboard, also set up: Authentication -> Emails -> Magic Link
# template must include {{ .Token }} so the email shows a code (not just a link) -
# this app's UI asks the user to type a code. Custom SMTP must be configured
# (Authentication -> Emails -> "Set up custom SMTP") before that template is editable
# at all, and before more than a couple of test emails/hour can be sent.

# Public - safe to expose to the browser. Used both server-side (SUPABASE_URL/
# SUPABASE_ANON_KEY) and inlined into the frontend build (VITE_ prefixed, same values).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side ONLY - bypasses row-level security. Never expose this to the browser,
# commit it, or put it in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key_here

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
PYTHON_PORT=5001

# Interpreter used to spawn the Python engine (e.g. python3, or a venv path).
# PYTHON_BIN=python

# Global daily cap on LLM-backed calls (optimize + skill-gap plan combined), shared
# across every visitor — separate from the per-IP optimizeLimiter. Gemini/Groq free
# tiers have a shared daily quota per account, not per visitor, so this keeps a
# widely-shared link from quietly using it all up; once hit, those routes return a
# clear message instead of silently degrading. Resets at UTC midnight.
# DAILY_LLM_CALL_LIMIT=150

# Comma-separated CORS allowlist. Same-origin only when unset.
# CORS_ORIGINS=https://your-app.onrender.com

# Request timeouts in milliseconds. Optimization waits on an LLM, so it gets more.
# ENGINE_TIMEOUT_MS=20000
# OPTIMIZE_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Local HTTPS (optional)
# ---------------------------------------------------------------------------
# SSL_KEY_PATH=./cert/key.pem
# SSL_CERT_PATH=./cert/cert.pem
# HTTPS_PORT=3443

# Resume-Buddy environment configuration.
# Copy to .env and fill in what you need: every value below has a working default
# except GROQ_API_KEY, which unlocks AI rewrites.

# ---------------------------------------------------------------------------
# AI engine (Dual-Tier: Gemini Primary -> Groq Fallback)
# ---------------------------------------------------------------------------
# Primary: Google Gemini API (Get key from https://aistudio.google.com)
# The application tries Gemini first.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Fallback: Groq Cloud (Free key from https://console.groq.com)
# If Gemini hits its rate limit or quota, Groq seamlessly takes over.
GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=groq/compound
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Output budget per LLM call. The optimizer's response is a full structured resume
# (contact, summary, skills, every bullet, education) plus audit metadata — raise this
# if you see truncated/unparseable JSON in the logs for long resumes.
# LLM_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
PYTHON_PORT=5001

# Signs session tokens issued at login/signup/OTP verification. Without this, a random
# secret is generated at process start and every restart signs every user out. Generate
# one with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# SESSION_SECRET=

# Interpreter used to spawn the Python engine (e.g. python3, or a venv path).
# PYTHON_BIN=python

# Where the SQLite user store is written. Point this at a mounted volume in
# production, or accounts are lost on every redeploy.
# RESUME_BUDDY_DATA_DIR=./data

# Comma-separated CORS allowlist. Same-origin only when unset.
# CORS_ORIGINS=https://your-app.onrender.com

# Request timeouts in milliseconds. Optimization waits on an LLM, so it gets more.
# ENGINE_TIMEOUT_MS=20000
# OPTIMIZE_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# OTP email delivery (optional)
# ---------------------------------------------------------------------------
# Without these, verification codes are printed to the server console instead of
# being emailed — fine for local development.

# Gmail: generate a 16-character App Password at
# https://myaccount.google.com/apppasswords
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

# Or any custom SMTP provider (Brevo, Resend, SendGrid, SES).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Resume-Buddy" <noreply@example.com>

# ---------------------------------------------------------------------------
# Local HTTPS (optional)
# ---------------------------------------------------------------------------
# SSL_KEY_PATH=./cert/key.pem
# SSL_CERT_PATH=./cert/cert.pem
# HTTPS_PORT=3443

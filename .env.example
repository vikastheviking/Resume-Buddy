# Resume-Buddy environment configuration.
# Copy to .env and fill in what you need: every value below has a working default
# except GROQ_API_KEY, which unlocks AI rewrites.

# ---------------------------------------------------------------------------
# AI engine (Dual-Tier: Gemini Primary -> Groq Fallback)
# ---------------------------------------------------------------------------
# Primary: Google Gemini API (Get key from https://aistudio.google.com)
# The application tries Gemini first.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Fallback: Groq Cloud (Free key from https://console.groq.com)
# If Gemini hits its rate limit or quota, Groq seamlessly takes over.
GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=groq/compound
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Output budget per LLM call. The optimizer's response is a full structured resume
# (contact, summary, skills, every bullet, education) plus audit metadata — raise this
# if you see truncated/unparseable JSON in the logs for long resumes.
# LLM_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
PYTHON_PORT=5001

# Signs session tokens issued at login/signup/OTP verification. Without this, a random
# secret is generated at process start and every restart signs every user out. Generate
# one with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# SESSION_SECRET=

# Interpreter used to spawn the Python engine (e.g. python3, or a venv path).
# PYTHON_BIN=python

# Global daily cap on /api/optimize calls (AI rewrites), shared across every visitor —
# separate from the per-IP optimizeLimiter. Gemini/Groq free tiers have a shared daily
# quota per account, not per visitor, so this keeps a widely-shared link from quietly
# using it all up; once hit, /api/optimize returns a clear message instead of every
# further request silently falling back to a non-AI reformat. Resets at UTC midnight.
# DAILY_OPTIMIZE_LIMIT=150

# Where the SQLite user store is written. Point this at a mounted volume in
# production, or accounts are lost on every redeploy.
# RESUME_BUDDY_DATA_DIR=./data

# Comma-separated CORS allowlist. Same-origin only when unset.
# CORS_ORIGINS=https://your-app.onrender.com

# Request timeouts in milliseconds. Optimization waits on an LLM, so it gets more.
# ENGINE_TIMEOUT_MS=20000
# OPTIMIZE_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# OTP email delivery (optional)
# ---------------------------------------------------------------------------
# Without any of these, verification codes are printed to the server console instead
# of being emailed — fine for local development. Checked in this order: Resend, then
# Gmail/SMTP. A configured-but-failing provider does NOT fall through to the next —
# it reports the real failure instead of silently pretending to succeed.

# Resend (https://resend.com, free tier): sends over HTTPS, so it works on hosts that
# block outbound SMTP (e.g. Render's free tier). Get an API key at
# https://resend.com/api-keys. Without a verified domain, the shared sandbox sender
# can only deliver to the email address your Resend account itself was signed up
# with — fine for testing, not for real visitors. Verify a domain you own (free) and
# set RESEND_FROM to an address on it to lift that restriction.
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM="ATS Resume Architect" <noreply@your-verified-domain.com>

# Gmail: generate a 16-character App Password at
# https://myaccount.google.com/apppasswords
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

# Or any custom SMTP provider (Brevo, SendGrid, SES). Subject to the same outbound-
# SMTP blocking some hosts apply — prefer Resend above on those.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Resume-Buddy" <noreply@example.com>

# ---------------------------------------------------------------------------
# Local HTTPS (optional)
# ---------------------------------------------------------------------------
# SSL_KEY_PATH=./cert/key.pem
# SSL_CERT_PATH=./cert/cert.pem
# HTTPS_PORT=3443

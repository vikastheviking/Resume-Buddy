# Resume-Buddy environment configuration.
# Copy to .env and fill in what you need: every value below has a working default
# except GROQ_API_KEY, which unlocks AI rewrites.

# ---------------------------------------------------------------------------
# AI engine
# ---------------------------------------------------------------------------
# Free key from https://console.groq.com
# Without it the app still runs, but only the structural (non-AI) pass is available.
GROQ_API_KEY=your_groq_api_key_here

# Point at any OpenAI-compatible provider instead of Groq.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
PYTHON_PORT=5001

# Interpreter used to spawn the Python engine (e.g. python3, or a venv path).
# PYTHON_BIN=python

# Where the SQLite user store is written. Point this at a mounted volume in
# production, or accounts are lost on every redeploy.
# RESUME_BUDDY_DATA_DIR=./data

# Comma-separated CORS allowlist. Same-origin only when unset.
# CORS_ORIGINS=https://your-app.onrender.com

# Request timeouts in milliseconds. Optimization waits on an LLM, so it gets more.
# ENGINE_TIMEOUT_MS=20000
# OPTIMIZE_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# OTP email delivery (optional)
# ---------------------------------------------------------------------------
# Without these, verification codes are printed to the server console instead of
# being emailed — fine for local development.

# Gmail: generate a 16-character App Password at
# https://myaccount.google.com/apppasswords
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

# Or any custom SMTP provider (Brevo, Resend, SendGrid, SES).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Resume-Buddy" <noreply@example.com>

# ---------------------------------------------------------------------------
# Local HTTPS (optional)
# ---------------------------------------------------------------------------
# SSL_KEY_PATH=./cert/key.pem
# SSL_CERT_PATH=./cert/cert.pem
# HTTPS_PORT=3443

{
  "name": "resume-buddy",
  "version": "2.0.0",
  "description": "ATS Resume Architect & Optimizer \u2014 Node.js web server fronting a Python resume-optimization engine",
  "main": "server/index.js",
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "dev:web": "vite",
    "test": "node tests/email-validator.test.js",
    "tunnel": "npx localtunnel --port 3000 --subdomain ats-resume-architect",
    "tunnel:cf": "cloudflared tunnel --url http://localhost:3000"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vikastheviking/Resume-Buddy.git"
  },
  "keywords": [
